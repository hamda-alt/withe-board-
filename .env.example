# ── MySQL connection ────────────────────────────────────────────────
# Option A: a single connection string
# DATABASE_URL="mysql://user:password@127.0.0.1:3306/taksam_whiteboard"

# Option B: discrete variables (used when DATABASE_URL is not set)
